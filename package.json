{
  "name": "summonflow",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 30220",
    "stripe:listen": "stripe listen --forward-to http://localhost:30220/api/stripe/webhook",
    "build": "prisma generate && next build",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "start": "next start --port 30220",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:component": "vitest run test/component",
    "test:functional": "vitest run test/functional",
    "test:e2e": "vitest run test/e2e",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@summoniq/signalsplash-client-sdk": "^1.1.3",
    "better-auth": "^1.6.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.562.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "dotenv": "^17.4.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prisma": "^7.7.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "packages/*"
  ]
}
