{
  "name": "@summoniq/summonflow-server-cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Worker + Durable Object runtime for SummonFlow.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
