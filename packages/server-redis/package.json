{
  "name": "@summoniq/summonflow-server-redis",
  "version": "0.1.0",
  "description": "Redis pubsub adapter for @summoniq/summonflow-server-node.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
